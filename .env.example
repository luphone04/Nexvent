# Local PostgreSQL; on Vercel this is provided by the Neon integration.
DATABASE_URL="postgresql://username:password@localhost:5432/nexvent?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Optional private owner account, created by npm run seed. Never publish its password.
ADMIN_EMAIL="owner@nexvent.example"
ADMIN_PASSWORD=""
# Vercel production only: insert missing demo records on build (never deletes data).
SEED_DEMO="false"
